POSTGRES_DB=jiashu
POSTGRES_USER=jiashu
POSTGRES_PASSWORD=example-only-change-before-use
DATABASE_URL=postgresql://jiashu:example-only-change-before-use@postgres:5432/jiashu
AUTH_SECRET=example-only-generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost
AUTH_TRUST_HOST=true
AUTH_RESEND_API_KEY=re_example_only_change_before_use
AUTH_RESEND_FROM="家书星球 <noreply@example.com>"
# The default production-like local entry is http://localhost:80.
NGINX_HOST_PORT=80
# Local Docker media stays on the named media_data volume.
MEDIA_STORAGE_ROOT=/data/media
DEMO_MODE=false
OPENAI_API_KEY=
# Text AI is disabled until API key, model, and endpoint are all set explicitly.
OPENAI_MODEL=
OPENAI_BASE_URL=
# Each non-text capability needs its own model; vision never falls back to text.
OPENAI_VISION_MODEL=
OPENAI_TRANSCRIPTION_MODEL=
OPENAI_EMBEDDING_MODEL=
